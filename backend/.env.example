# ====================================
# Khushhaal Backend - Environment Config
# Copy this file to .env and fill in your values
# ====================================

# Server
PORT=5000
NODE_ENV=production

# MongoDB Atlas URI (Railway se deploy karte waqt yahan Atlas URI daalna)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/khushhaal_db?retryWrites=true&w=majority

# JWT Secrets (strong random strings use karein production mein)
JWT_SECRET=your_very_strong_jwt_secret_here_min_32_chars
REFRESH_SECRET=your_very_strong_refresh_secret_here_min_32_chars

# Firebase (Coach AI feature ke liye)
FIREBASE_PROJECT_ID=your_firebase_project_id

# CORS — comma-separated allowed origins for production
# Example: https://your-admin-panel.railway.app,https://www.khushhaal.app
ALLOWED_ORIGINS=

# Seed endpoint (development/staging only — never enable in production)
ENABLE_SEED_ENDPOINT=false
SEED_SECRET=change_this_to_a_random_secret_string
SEED_ADMIN_PHONE=+923001234567
SEED_ADMIN_CNIC=35201-0000001-1
SEED_ADMIN_NAME=Khushhaal Admin
# SEED_ADMIN_PASSWORD must be set in actual .env — never commit it
SEED_ADMIN_PASSWORD=
